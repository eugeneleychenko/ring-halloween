{
  "name": "ring-halloween",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Halloween doorbell prototype: Ring events, snapshots and doorbell speaker playback",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "bin/node24 src/cli/start.js",
    "simulate": "bin/node24 src/cli/simulate.js",
    "auth": "bin/node24 src/cli/auth.js",
    "devices": "bin/node24 src/cli/devices.js",
    "probe-speaker": "bin/node24 src/cli/probe.js",
    "report": "bin/node24 src/cli/report.js",
    "test": "bin/node24 --test --test-concurrency=1 --test-timeout=30000 --test-force-exit \"test/*.test.js\"",
    "eval-gemini": "bin/node24 src/cli/eval-gemini.js",
    "build-clips": "bin/node24 src/cli/build-clips.js",
    "measure-tts": "bin/node24 src/cli/measure-tts.js",
    "listen": "bin/node24 src/cli/listen.js",
    "uat": "bin/node24 src/cli/uat.js",
    "rate-speaker": "bin/node24 src/cli/rate-speaker.js",
    "check": "bin/node24 src/cli/check.js",
    "night": "bin/keep-running",
    "live-clips": "bin/node24 src/cli/live-clips.js",
    "try-chain": "bin/node24 src/cli/try-chain.js"
  },
  "dependencies": {
    "ring-client-api": "14.3.0",
    "rxjs": "^7.8.2",
    "werift": "0.22.4",
    "undici": "7.30.1"
  },
  "overrides": {
    "@eneris/push-receiver": "4.4.0"
  }
}
