# Copy this file to .env and fill in what you need. The real .env is never committed.
# A .env in the folder above this one (Ring_Halloween/.env) is read as well;
# a setting in ring-halloween/.env wins over the same setting up there.
# The Ring login is not stored here: `npm run auth` saves a token to ring-token.json.

# Where the voice comes out: bluetooth, doorbell or both
OUTPUT=bluetooth

# Personality choices
# What to do when the AI sees nobody: silence, line for a short joke, or fallback for a compliment anyway
SKIP_BEHAVIOR=silence
# Add a goodbye line after each comment: true or false
SIGN_OFF=false
# Play a short "who's there?" line the moment motion is seen: true or false
COVER_CLIP=true
# The character's name in the AI prompt
CHARACTER_NAME=Malyx

# The outdoor Bluetooth speaker: its name in Sound settings, and its address
BLUETOOTH_SPEAKER_NAME=
BLUETOOTH_SPEAKER_ADDRESS=
# The Mac's volume for each play, 0 to 100, or unchanged to leave it alone
BLUETOOTH_VOLUME=80
# BLUETOOTH_KEEPALIVE_MS=120000
# BLUETOOTH_HEALTH_CHECK_MS=30000

# Google Gemini (writes the costume comment)
GEMINI_API_KEY=
# Set to true only after checking that the key's project has billing on. On the free
# tier Google staff may read what is sent, so door snapshots are not sent until then.
GEMINI_BILLING_CONFIRMED=false

# ElevenLabs (speaks the comment)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Only needed when your Ring account has more than one doorbell
# RING_DEVICE_NAME=Front Door
# RING_DEVICE_ID=

# Advanced. These are the defaults; you should not need to change them.
# FFMPEG_PATH=ffmpeg
# COOLDOWN_MS=10000
# CAMERA_CONNECTED_TIMEOUT_MS=15000
# SPEAKER_SETTLE_MS=400
# OPUS_BITRATE=
# PACED_SEND=true
# DOORBELL_VIDEO_OFF=false
# TRAILING_SILENCE_MS=700
# MAX_SESSION_MS=25000
# SNAPSHOT_UUID_WAIT_BATTERY_MS=2000
# SNAPSHOT_UUID_WAIT_WIRED_MS=500
# SNAPSHOT_UUID_TOLERANCE_MS=2000
# SNAPSHOT_ROUTE_TIMEOUT_MS=4000
# CLOSER_FRAME=true
# CLOSER_FRAME_DELAY_MS=2000
# CLOSER_FRAME_WAIT_MS=5000
# KEYFRAME_TIMEOUT_MS=10000
# GEMINI_FRAMES=best
# GEMINI_PROMPT=plain
# GEMINI_CROP=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_MEDIA_RESOLUTION=low
# GEMINI_IMAGE_MAX_PX=768
# GEMINI_TEMPERATURE=0.6
# GEMINI_MAX_OUTPUT_TOKENS=120
# GEMINI_TIMEOUT_MS=2500
# GEMINI_WARMUP_MS=300000
# ELEVENLABS_BASE_URL=https://api.us.elevenlabs.io
# ELEVENLABS_MODEL=eleven_flash_v2_5
# TTS_STABILITY=0.55
# TTS_SIMILARITY_BOOST=0.8
# TTS_STYLE=0
# TTS_SPEED=0.92
# TTS_SPEAKER_BOOST=true
# TTS_USE_PVC_AS_IVC=false
# TTS_HIGHPASS_HZ=200
# TTS_PRESENCE_DB=0
# TTS_LEADING_SILENCE_MS=300
# TTS_TIMEOUT_MS=5000
# CLIPS_DIR=clips
# KEEP_RUNNING_COMMAND=
# RESTART_DELAY_SECONDS=10
# HEARTBEAT_MAX_AGE_SECONDS=180
# RING_NODE=/path/to/a/node24/binary
# RING_TOKEN_DIR=.
# MEASUREMENTS_DIR=measurements
# SNAPSHOTS_DIR=snapshots
